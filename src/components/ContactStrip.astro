---
import { profile } from "../data/profile";
---

<footer class="contact-strip">
  <div class="contact-topline">
    <p>04 / Contact</p>
    <p>Data becomes valuable when people can act on it.</p>
  </div>

  <div class="contact-main">
    <p class="contact-kicker">Have a problem worth understanding?</p>
    <a class="contact-heading" href={`mailto:${profile.email}`}>
      Let’s build something useful.<span aria-hidden="true">↗</span>
    </a>
  </div>

  <div class="contact-bottom">
    <p>© {new Date().getFullYear()} Shravani Patil</p>
    <div class="contact-links">
      <a href={profile.github} target="_blank" rel="noreferrer">GitHub</a>
      <a href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
      <a href={`mailto:${profile.email}`}>{profile.email}</a>
    </div>
  </div>
</footer>
